{
  "name": "bugbit",
  "version": "1.3.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "bundle:scripts": "ncc build scripts/lib/operations.mjs -o dist/scripts/operations && ncc build scripts/lib/preflight.mjs -o dist/scripts/preflight",
    "bundle:vendor": "node scripts/copy-rg-vendor.mjs",
    "bundle": "pnpm run build && pnpm run bundle:scripts && ncc build lib/main.js -o dist && pnpm run bundle:vendor",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.2",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@actions/artifact": "^2.2.1",
    "@actions/core": "^1.11.1",
    "@actions/github": "^9.1.1",
    "@cursor/sdk": "^1.0.23"
  },
  "optionalDependencies": {
    "@cursor/sdk-linux-x64": "1.0.23"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@vercel/ncc": "^0.44.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
